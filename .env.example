# Deployer Private Key (without 0x prefix or with 0x)
PRIVATE_KEY="<your-deployer-private-key>"

# Optional: If using Ledger hardware wallet
# LEDGER_ACCOUNT="<your-ledger-account-address>"

# Deploy Strategy: "create2" for unified addresses across networks, or "basic" for simple incremental nonce deployment
DEPLOY_STRATEGY=create2

# me-hub JSON-RPC Endpoint
MEHUB_RPC_URL=http://127.0.0.1:8545

# Optional: Block explorer API key (if available)
ETHERSCAN_API_KEY=""
